<Page
    x:Class="Lively.UI.WinUI.Views.Pages.Settings.SettingsScreensaverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:customConverters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lively.UI.WinUI.Views.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <customConverters:AudioVolumeGlyphConverter x:Key="AudioVolumeGlyphConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="10,25,10,5" Spacing="{StaticResource SettingGroupControlSpacing}">
                <!--  Screensaver  -->
                <StackPanel>
                    <TextBlock
                        x:Uid="ScreensaverOptionsGroup"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />

                    <controls:SettingsCard x:Uid="ScreensaverWaitTime">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE916;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{Binding SelectedScreensaverWaitIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="TextOff" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="20" />
                            <ComboBoxItem Content="25" />
                            <ComboBoxItem Content="30" />
                            <ComboBoxItem Content="45" />
                            <ComboBoxItem Content="60" />
                            <ComboBoxItem Content="120" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="ScreensaverLockOnResume">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsLockOnResume, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="ScreensaverFadeIn">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsFadeIn, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </StackPanel>

                <!--  Audio  -->
                <StackPanel>
                    <TextBlock
                        x:Uid="AudioGroup"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />
                    <controls:SettingsCard x:Uid="Audio" HeaderIcon="{Binding Volume, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource AudioVolumeGlyphConverter}}">
                        <Slider
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        x:Uid="System"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />
                    <controls:SettingsCard
                        x:Uid="ScreensaverWindowsSettings"
                        Command="{Binding OpenWindowsSettingsCommand}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE770;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                    <!--  Windows only launches a .scr file, so the picker above has to be pointed at Luma once.  -->
                    <InfoBar
                        x:Uid="ScreensaverWindowsHint"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
